# 外部クローンリポジトリ（models/ 配下のすべてのサブディレクトリ）
# DnCNN, KAIR, NAFNet, Restormer, SCUNet など今後追加するモデルもすべて対象
models/*/

# 推論結果（生成物、大容量バイナリ）
results/*
# カスタム学習済み重みは Git LFS で追跡（results/ を丸ごと除外するとネゲーションが効かない）
!results/trained_models/
!results/trained_models/*.pth

# テスト入力画像（大容量バイナリ）
test_inputs/

# 劣化可視化用入力画像
degradation_inputs/

# 学習データセット（大容量バイナリ）
trainsets/

# テストセット（画像ファイルのみ除外、README / .gitkeep は追跡）
testsets/**/*.jpg
testsets/**/*.jpeg
testsets/**/*.png
testsets/**/*.bmp
testsets/**/*.tif
testsets/**/*.tiff

# セッション固有ファイル
claude-resume.sh

# Python
__pycache__/
*.py[cod]
*.pyo
.Python
*.egg-info/
dist/
build/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
